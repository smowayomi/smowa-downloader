{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Smowa",
  "version": "0.1.0",
  "identifier": "com.smowa.downloader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Smowa",
        "width": 1180,
        "height": 820,
        "minWidth": 860,
        "minHeight": 650
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: https: data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": { "active": false }
}
