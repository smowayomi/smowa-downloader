{
  "manifest_version": 3,
  "name": "Smowa \u00e2\u20ac\u201d Send to desktop",
  "version": "0.1.3",
  "description": "Send video or audio pages from any yt-dlp-supported website to Smowa.",
  "permissions": ["activeTab", "nativeMessaging"],
  "action": {
    "default_title": "Download with Smowa",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
