{
  "manifest_version": 3,
  "name": "SmowaDL - Send to desktop",
  "version": "0.2.0",
  "description": "Open video and audio in SmowaDL to choose quality and download.",
  "permissions": [
    "activeTab",
    "nativeMessaging"
  ],
  "action": {
    "default_title": "Download with SmowaDL",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.instagram.com/*",
        "*://*.x.com/*",
        "*://*.twitter.com/*",
        "*://*.tiktok.com/*"
      ],
      "js": [
        "media-buttons.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
